# Copy to .env.local and fill in. Never commit .env.local.

# Waitlist form endpoint. Any service accepting a JSON POST works —
# Formspree (https://formspree.io/f/XXXXXXX), Basin, or your own worker.
# Until this is set, the waitlist form tells visitors signup is not live
# and gives them the practice email instead of failing silently.
VITE_WAITLIST_ENDPOINT=

# Booking. 'native' uses the built-in request flow; 'ehr' redirects out.
VITE_BOOKING_MODE=native
VITE_EHR_BOOKING_URL=
